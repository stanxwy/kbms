# ====================
# KBMS Admin 后端本地开发环境变量
# ====================
# 说明：容器化部署时，这些变量由 app/docker-compose.yml 的 env_file(.env.prod) +
# environment 注入，本文件仅供本地 `uvicorn admin.main:app` 直跑使用，请复制为 .env。

# 应用
APP_NAME=KBMS Admin
VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# 异步 DSN（应用运行时，asyncpg）
DATABASE_URL=postgresql+asyncpg://kbms:kbms@localhost:5432/kbms
# 同步 DSN（Alembic 迁移，psycopg2）
DATABASE_SYNC_URL=postgresql+psycopg2://kbms:kbms@localhost:5432/kbms

# RAG 引擎入口（admin 通过 HTTP 调用）
RAG_BASE_URL=http://localhost:8000

# JWT
JWT_SECRET=please-change-me-to-a-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAY=14

# 初始超级用户（init_seed.py 幂等创建）
INITIAL_SUPERUSER_USERNAME=admin
INITIAL_SUPERUSER_PASSWORD=admin123
INITIAL_SUPERUSER_EMAIL=admin@example.com

# FAQ 挖掘阈值与窗口
FAQ_MIN_FREQ_THRESHOLD=5
FAQ_MIN_WINDOW_DAYS=7
FAQ_MINER_INTERVAL_MIN=60
FAQ_MATCH_THRESHOLD=0.85

# CORS（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8002